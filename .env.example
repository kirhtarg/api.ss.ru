APP_NAME=api.ss
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ss_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_WORKER_HEARTBEAT_TTL=90
DB_QUEUE_RETRY_AFTER=7500
REDIS_QUEUE_RETRY_AFTER=7500

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FRONTEND_URL=skyandsnow.ru

# CORS настройки
CORS_ALLOWED_ORIGINS=https://skateandsnow.ru,https://admin.skateandsnow.ru,https://api.skateandsnow.ru

MAIL_MAILER=smtp
MAIL_HOST=ваш-smtp-сервер
MAIL_PORT=587
MAIL_USERNAME=ваш-email
MAIL_PASSWORD=ваш-пароль
MAIL_ENCRYPTION=tls
#MAIL_FROM_ADDRESS=noreply@${FRONTEND_URL}
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=ваш_google_client_id
GOOGLE_CLIENT_SECRET=ваш_google_client_secret
GOOGLE_REDIRECT_URI=https://ваш-домен.com/api/auth/google/callback

VK_CLIENT_ID=ваш_vk_client_id
VK_CLIENT_SECRET=ваш_vk_client_secret
VK_REDIRECT_URI=http://localhost:8000/api/auth/vk/callback


CALL_PROVIDER=smsprofi
SMSPROFI_API_KEY=
SMSPROFI_FROM=SkateAndSnow

TBANK_API_URL_TEST="https://sandbox.api.tbank.ru/v1"
TBANK_API_URL_LIVE="https://api.tbank.ru/v1"

# Partner API
PARTNER_API_SIGNATURE_TTL=300
PARTNER_API_RATE_LIMIT=120
PARTNER_RESERVATION_TTL_MINUTES=30
PARTNER_WEBHOOK_TIMEOUT=10
PARTNER_WEBHOOK_MAX_ATTEMPTS=8
PARTNER_WEBHOOK_ALLOW_HTTP=false
PARTNER_WEBHOOK_ALLOWED_PORTS=443

HTTP_CLIENT_VERIFY=true
HTTP_CLIENT_CA_BUNDLE=/path/to/cacert.pem
TOPSPORTS_VERIFY_SSL=true
# TOPSPORTS_CA_BUNDLE=/path/to/cacert.pem

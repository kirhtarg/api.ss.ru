APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Email настройки
# MAIL_FROM_ADDRESS автоматически генерируется из FRONTEND_URL как noreply@домен
# Если нужно задать вручную, раскомментируйте и укажите свой email:
# MAIL_FROM_ADDRESS="noreply@yoursite.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend URL for email verification links
# Из этого URL автоматически извлекается домен для MAIL_FROM_ADDRESS
FRONTEND_URL=https://admin.skateandsnow.ru

# Google OAuth настройки
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# VK OAuth настройки
VK_CLIENT_ID=your_vk_client_id
VK_CLIENT_SECRET=your_vk_client_secret
VK_REDIRECT_URI=https://ss75-api.kirhtarg.ru/api/auth/vk/callback

# VK ID SDK настройки (для нового виджета)

# Google Fonts настройки
SITE_GOOGLE_FONT=Inter
VK_APP_ID=54111129
VK_SDK_REDIRECT_URI=https://ss75-api.kirhtarg.ru/api/auth/vk/sdk-callback

# Yandex OAuth настройки
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=https://ss75-api.kirhtarg.ru/api/auth/yandex/callback

# Провайдер звонков (voicepassword, loginbot, unibell, authcalls, smsprofi)
CALL_PROVIDER=voicepassword

# Voice Password настройки (рекомендуется)
VOICEPASSWORD_API_KEY=your_voicepassword_api_key
VOICEPASSWORD_API_URL=https://api.voicepassword.ru/call
VOICEPASSWORD_FROM=SkateAndSnow

# LoginBot настройки
LOGINBOT_API_KEY=your_loginbot_api_key
LOGINBOT_API_URL=https://api.loginbot.ru/call
LOGINBOT_FROM=SkateAndSnow

# Unibell настройки
UNIBELL_API_KEY=your_unibell_api_key
UNIBELL_API_URL=https://api.unibell.ru/call
UNIBELL_FROM=SkateAndSnow

# AuthCalls настройки
AUTHCALLS_API_KEY=your_authcalls_api_key
AUTHCALLS_API_URL=https://api.authcalls.net/call
AUTHCALLS_FROM=SkateAndSnow

# SMSProfi.ru настройки для звонков (дешевый)
SMSPROFI_API_KEY=your_smsprofi_api_key
SMSPROFI_CALL_API_URL=https://lcab.smsprofi.ru/json/v1.0/callpassword/send
SMSPROFI_FROM=SkateAndSnow

# Резервные SMS провайдеры (если звонки недоступны)
SMS_PROVIDER=smsru

# SMS.ru настройки
SMSRU_API_ID=your_smsru_api_id
SMSRU_API_URL=https://sms.ru/sms/send
SMSRU_FROM=SkateAndSnow

# SMSProfi.ru настройки (более дешевый)
SMSPROFI_LOGIN=your_smsprofi_login
SMSPROFI_PASSWORD=your_smsprofi_password
SMSPROFI_API_URL=https://api.smsprofi.ru/send
SMSPROFI_FROM=SkateAndSnow

# Notify.lk настройки (альтернативный)
NOTIFYLK_USER_ID=your_notifylk_user_id
NOTIFYLK_API_KEY=your_notifylk_api_key
NOTIFYLK_API_URL=https://app.notify.lk/api/v1/send
NOTIFYLK_FROM=NotifyDEMO

# CORS настройки (через запятую, без пробелов)
CORS_ALLOWED_ORIGINS=https://ss75.kirhtarg.ru,http://ss75.kirhtarg.ru,https://admin.skateandsnow.ru,http://admin.skateandsnow.ru
CORS_ALLOWED_PATTERNS=*\.kirhtarg\.ru$,*\.skateandsnow\.ru$,localhost:\d+,127\.0\.0\.1:\d+

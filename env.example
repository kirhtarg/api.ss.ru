APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Путь к папке фронтенда: относительный от корня API (base_path).
# Обязательная переменная: в коде нет запасного значения. При смене проекта (другое имя папки) — задайте свой путь.
# Пример: ../admin.skateandsnow.ru или ../my-admin-frontend
FRONTEND_PATH=../admin.skateandsnow.ru

# DaData API ключи
DADATA_API_KEY=your_dadata_api_key_here
DADATA_SECRET_KEY=your_dadata_secret_key_here

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Email настройки
# MAIL_FROM_ADDRESS автоматически генерируется из FRONTEND_URL как noreply@домен
# Если нужно задать вручную, раскомментируйте и укажите свой email:
# MAIL_FROM_ADDRESS="noreply@yoursite.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend URL for email verification links
# Из этого URL автоматически извлекается домен для MAIL_FROM_ADDRESS
FRONTEND_URL=https://admin.skateandsnow.ru

# Google OAuth настройки
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# VK OAuth настройки
VK_CLIENT_ID=your_vk_client_id
VK_CLIENT_SECRET=your_vk_client_secret
VK_REDIRECT_URI=https://ss75-api.kirhtarg.ru/api/auth/vk/callback

# VK ID SDK настройки (для нового виджета)

# Google Fonts настройки
SITE_GOOGLE_FONT=Inter
VK_APP_ID=54111129
VK_SDK_REDIRECT_URI=https://ss75-api.kirhtarg.ru/api/auth/vk/sdk-callback

# Yandex OAuth настройки
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=https://ss75-api.kirhtarg.ru/api/auth/yandex/callback

# Yandex Pay (Web SDK + Merchant API)
YANDEX_PAY_MERCHANT_ID=your_yandex_pay_merchant_id
YANDEX_PAY_SECRET_KEY=your_yandex_pay_api_key
YANDEX_PAY_MODE=test # test|live
YANDEX_PAY_CURRENCY=RUB

# Провайдер звонков (voicepassword, loginbot, unibell, authcalls, smsprofi)
CALL_PROVIDER=voicepassword

# Voice Password настройки (рекомендуется)
VOICEPASSWORD_API_KEY=your_voicepassword_api_key
VOICEPASSWORD_API_URL=https://api.voicepassword.ru/call
VOICEPASSWORD_FROM=SkateAndSnow

# LoginBot настройки
LOGINBOT_API_KEY=your_loginbot_api_key
LOGINBOT_API_URL=https://api.loginbot.ru/call
LOGINBOT_FROM=SkateAndSnow

# Unibell настройки
UNIBELL_API_KEY=your_unibell_api_key
UNIBELL_API_URL=https://api.unibell.ru/call
UNIBELL_FROM=SkateAndSnow

# AuthCalls настройки
AUTHCALLS_API_KEY=your_authcalls_api_key
AUTHCALLS_API_URL=https://api.authcalls.net/call
AUTHCALLS_FROM=SkateAndSnow

# SMSProfi.ru настройки для звонков (дешевый)
SMSPROFI_API_KEY=your_smsprofi_api_key
SMSPROFI_CALL_API_URL=https://lcab.smsprofi.ru/json/v1.0/callpassword/send
SMSPROFI_FROM=SkateAndSnow

# Резервные SMS провайдеры (если звонки недоступны)
SMS_PROVIDER=smsru

# SMS.ru настройки
SMSRU_API_ID=your_smsru_api_id
SMSRU_API_URL=https://sms.ru/sms/send
SMSRU_FROM=SkateAndSnow

# SMSProfi.ru настройки (более дешевый)
SMSPROFI_LOGIN=your_smsprofi_login
SMSPROFI_PASSWORD=your_smsprofi_password
SMSPROFI_API_URL=https://api.smsprofi.ru/send
SMSPROFI_FROM=SkateAndSnow

# Notify.lk настройки (альтернативный)
NOTIFYLK_USER_ID=your_notifylk_user_id
NOTIFYLK_API_KEY=your_notifylk_api_key
NOTIFYLK_API_URL=https://app.notify.lk/api/v1/send
NOTIFYLK_FROM=NotifyDEMO

# CORS настройки (через запятую, без пробелов)
CORS_ALLOWED_ORIGINS=https://ss75.kirhtarg.ru,http://ss75.kirhtarg.ru,https://admin.skateandsnow.ru,http://admin.skateandsnow.ru,https://skateandsnow-test.ru,https://admin.skateandsnow-test.ru,https://api.skateandsnow-test.ru,https://skateandsnow.ru,https://admin.skateandsnow.ru,https://api.skateandsnow.ru
CORS_ALLOWED_PATTERNS=*\.kirhtarg\.ru$,*\.skateandsnow\.ru$,*\.skateandsnow-test\.ru$,localhost:\d+,127\.0\.0\.1:\d+

# Telegram Bot настройки для уведомлений о заказах
# ПРИМЕЧАНИЕ: Теперь можно управлять каналами оповещений через админку (раздел "Оповещения магазина")
# Эти настройки используются как резервные/по умолчанию
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_CUSTOMER_CHAT_ID=your_customer_chat_id
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_RETRY_DELAY=300
# ВНИМАНИЕ: Отключение проверки SSL небезопасно! Используйте только если на сервере проблемы с SSL сертификатами
# TELEGRAM_VERIFY_SSL=false

# Email настройки для отправки уведомлений
# ПРИМЕЧАНИЕ: Настройки SMTP для отправки email уведомлений
# Каналы оповещений настраиваются через админку, но здесь можно указать общие настройки SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# СДЭК интеграция
CDEK_API_URL=https://api.cdek.ru/v2
CDEK_CLIENT_ID=your_cdek_client_id
CDEK_CLIENT_SECRET=your_cdek_client_secret
CDEK_SENDER_CITY_ID=44
CDEK_SENDER_ADDRESS=г. Москва, ул. Примерная, д. 1
CDEK_SENDER_PHONE=+7 (999) 123-45-67
CDEK_SENDER_NAME=ООО "Скейт энд Сноу"

# DaData API для подсказок адресов
DADATA_API_KEY=your_dadata_api_key

# Тест-Банк интеграция
TESTBANK_API_URL=https://test-bank.example.com/api
TESTBANK_API_KEY=your_testbank_api_key
TESTBANK_MERCHANT_ID=your_testbank_merchant_id
TESTBANK_WEBHOOK_SECRET=your_webhook_secret
TESTBANK_TEST_MODE=true

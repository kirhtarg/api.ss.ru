{
  "openapi": "3.1.0",
  "info": {
    "title": "Skate & Snow Partner API",
    "version": "1.1.0",
    "description": "API для синхронизации каталога и создания партнёрских заказов. HMAC query канонизируется из сырой строки: каждая key/value пара form-url-decode (включая + как пробел), затем RFC 3986 encode, сортировка по encoded key и value; дубликаты, массивы и пустые значения сохраняются. Каноническая строка: METHOD, /api/partner/v1/path, canonical query без ?, SHA-256 сырого тела, Unix timestamp и уникальный nonce — каждое значение на отдельной строке."
  },
  "servers": [{ "url": "/api/partner/v1", "description": "Текущий сервер" }],
  "tags": [
    { "name": "System", "description": "Проверка подключения" },
    { "name": "Catalog", "description": "Каталог и остатки" },
    { "name": "Checkout", "description": "Доставка и оплата" },
    { "name": "Orders", "description": "Партнёрские заказы" }
  ],
  "security": [{ "PartnerKey": [], "PartnerTimestamp": [], "PartnerNonce": [], "PartnerSignature": [] }],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"], "summary": "Проверить подключение", "operationId": "partnerHealth",
        "responses": { "200": { "description": "API доступен", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/catalog/categories": {
      "get": {
        "tags": ["Catalog"], "summary": "Получить категории", "operationId": "listPartnerCategories", "x-required-scope": "catalog:read",
        "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/UpdatedSince" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "description": "Без sync-параметров сохраняется legacy-массив; с параметрами возвращается пагинированная v1.1-лента.", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/CategoryListResponse" }, { "$ref": "#/components/schemas/CategoryPageResponse" }] } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/catalog/brands": {
      "get": {
        "tags": ["Catalog"], "summary": "Получить активные бренды", "operationId": "listPartnerBrands", "x-required-scope": "catalog:read",
        "responses": { "200": { "description": "Бренды доступных товаров", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Brand" } } } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/catalog/products": {
      "get": {
        "tags": ["Catalog"], "summary": "Получить товары", "operationId": "listPartnerProducts", "x-required-scope": "catalog:read",
        "parameters": [
          { "name": "category_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "brand_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 120 } },
          { "name": "include_unavailable", "in": "query", "description": "Для административного каталога: включить активные отображаемые товары без доступного локального остатка. Не меняет правила checkout.", "schema": { "type": "boolean", "default": false } },
          { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" },
          { "$ref": "#/components/parameters/UpdatedSince" }, { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": { "200": { "description": "Пагинированный каталог", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductPageResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/catalog/products/{good}": {
      "get": {
        "tags": ["Catalog"], "summary": "Получить товар", "operationId": "getPartnerProduct", "x-required-scope": "catalog:read",
        "parameters": [{ "name": "good", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Товар", "content": { "application/json": { "schema": { "type": "object", "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "$ref": "#/components/schemas/Product" } } } } } }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/checkout/options": {
      "get": {
        "tags": ["Checkout"], "summary": "Получить способы доставки и оплаты", "operationId": "getPartnerCheckoutOptions", "x-required-scope": "checkout:read",
        "responses": { "200": { "description": "Активные способы", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutOptionsResponse" } } } }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/checkout/quote": {
      "post": { "tags": ["Checkout"], "summary": "Предварительно рассчитать checkout без создания заказа", "operationId": "createPartnerQuote", "x-required-scope": "checkout:read", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteRequest" } } } }, "responses": { "200": { "description": "Актуальный расчёт", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteResponse" } } } }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/delivery/cities": { "get": { "tags": ["Checkout"], "summary": "Поиск города", "operationId": "searchPartnerDeliveryCities", "x-required-scope": "checkout:read", "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2, "maxLength": 120 } }], "responses": { "200": { "description": "Города", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryCityPage" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } } } },
    "/delivery/tariffs": { "post": { "tags": ["Checkout"], "summary": "Доступные тарифы", "operationId": "listPartnerDeliveryTariffs", "x-required-scope": "checkout:read", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteRequest" } } } }, "responses": { "200": { "description": "Тарифы", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryTariffPage" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } } } },
    "/delivery/pickup-points": { "get": { "tags": ["Checkout"], "summary": "Получить ПВЗ", "operationId": "listPartnerPickupPoints", "x-required-scope": "checkout:read", "parameters": [{ "name": "city_code", "in": "query", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "ПВЗ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PickupPointPage" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } } } },
    "/delivery/pickup-points/validate": { "post": { "tags": ["Checkout"], "summary": "Проверить ПВЗ", "operationId": "validatePartnerPickupPoint", "x-required-scope": "checkout:read", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PickupPointValidationRequest" } } } }, "responses": { "200": { "description": "Результат проверки", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PickupPointValidation" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } } } },
    "/orders": {
      "get": { "tags": ["Orders"], "summary": "Reconciliation заказов", "operationId": "listPartnerOrders", "x-required-scope": "orders:read", "parameters": [{ "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/UpdatedSince" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Изменённые заказы", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderPage" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/RateLimited" } } },
      "post": {
        "tags": ["Orders"], "summary": "Создать заказ", "operationId": "createPartnerOrder", "x-required-scope": "orders:write",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } } },
        "responses": {
          "201": { "description": "Заказ создан", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } },
          "200": { "description": "Идемпотентный повтор", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } },
          "409": { "description": "Конфликт idempotency key" }, "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/orders/{externalOrderId}/cancel": { "post": { "tags": ["Orders"], "summary": "Отменить неоплаченный заказ", "operationId": "cancelPartnerOrder", "x-required-scope": "orders:write", "parameters": [{ "$ref": "#/components/parameters/ExternalOrderId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelOrderRequest" } } } }, "responses": { "200": { "description": "Заказ отменён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } } } },
    "/commissions": { "get": { "tags": ["Orders"], "summary": "Reconciliation комиссий", "operationId": "listPartnerCommissions", "x-required-scope": "commissions:read", "parameters": [{ "$ref": "#/components/parameters/PerPage" }, { "$ref": "#/components/parameters/UpdatedSince" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "description": "Изменённые комиссии", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommissionPage" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "429": { "$ref": "#/components/responses/RateLimited" } } } },
    "/orders/{externalOrderId}": {
      "get": {
        "tags": ["Orders"], "summary": "Получить заказ", "operationId": "getPartnerOrder", "x-required-scope": "orders:read",
        "parameters": [{ "$ref": "#/components/parameters/ExternalOrderId" }],
        "responses": { "200": { "description": "Заказ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/orders/{externalOrderId}/payment": {
      "post": {
        "tags": ["Checkout"], "summary": "Создать или повторить платёж", "operationId": "createPartnerPayment", "x-required-scope": "payments:write",
        "parameters": [{ "$ref": "#/components/parameters/ExternalOrderId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "payment_method_id": { "type": ["integer", "null"] } } } } } },
        "responses": { "201": { "description": "Платёж создан", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentResponse" } } } }, "200": { "description": "Идемпотентный повтор", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" }, "429": { "$ref": "#/components/responses/RateLimited" } }
      }
    }
  },
  "webhooks": {
    "partnerEvent": {
      "post": {
        "summary": "Исходящее событие Partner API",
        "parameters": [
          { "name": "X-Partner-Delivery", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "X-Partner-Event", "in": "header", "required": true, "schema": { "type": "string", "enum": ["test", "order.created", "order.updated", "order.status_changed", "order.cancelled", "payment.status_changed", "payment.succeeded", "payment.failed", "delivery.status_changed", "commission.updated", "commission.approved", "commission.reversed"] } },
          { "name": "X-Partner-Timestamp", "in": "header", "required": true, "schema": { "type": "string" }, "description": "Unix seconds; рекомендуемое окно проверки ±300 секунд." },
          { "name": "X-Partner-Signature", "in": "header", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "description": "hex(HMAC-SHA256(timestamp + '.' + rawBody, webhook_secret))." }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookPayload" } } } },
        "responses": { "200": { "description": "Событие принято. Получатель обязан дедуплицировать X-Partner-Delivery." } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PartnerKey": { "type": "apiKey", "in": "header", "name": "X-Partner-Key", "description": "Key ID, не секрет." },
      "PartnerTimestamp": { "type": "apiKey", "in": "header", "name": "X-Partner-Timestamp", "description": "Текущее Unix-время в секундах. Допуск по умолчанию ±300 секунд." },
      "PartnerNonce": { "type": "apiKey", "in": "header", "name": "X-Partner-Nonce", "description": "Уникальная случайная строка для каждого запроса." },
      "PartnerSignature": { "type": "apiKey", "in": "header", "name": "X-Partner-Signature", "description": "hex(HMAC-SHA256(canonical_string, secret))." }
    },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" }, "description": "Уникален в пределах партнёра для одной операции. Ключ платежа нельзя повторно использовать для другого заказа." },
      "ExternalOrderId": { "name": "externalOrderId", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 128 } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "PerPage": { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 24 } },
      "UpdatedSince": { "name": "updated_since", "in": "query", "schema": { "type": "string", "format": "date-time" } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string", "maxLength": 512 }, "description": "Непрозрачный cursor из meta.next_cursor; сортировка всегда updated_at,id." }
    },
    "schemas": {
      "Category": { "type": "object", "additionalProperties": false, "required": ["id", "parent_id", "name", "slug", "image_url", "is_active", "sort_order", "updated_at"], "properties": { "id": { "type": "integer" }, "parent_id": { "type": ["integer", "null"] }, "name": { "type": "string" }, "slug": { "type": "string" }, "image_url": { "type": ["string", "null"], "format": "uri" }, "is_active": { "type": "boolean" }, "sort_order": { "type": "integer" }, "updated_at": { "type": ["string", "null"], "format": "date-time" } } },
      "CatalogImage": { "type": "object", "additionalProperties": false, "required": ["id", "url", "alt", "is_main", "sort_order"], "properties": { "id": { "type": "integer" }, "url": { "type": ["string", "null"] }, "alt": { "type": ["string", "null"] }, "is_main": { "type": "boolean" }, "sort_order": { "type": "integer" } } },
      "CatalogAttributeValue": { "type": "object", "additionalProperties": false, "required": ["id", "code", "label", "color"], "properties": { "id": { "type": "integer" }, "code": { "type": "string" }, "label": { "type": "string" }, "color": { "type": ["string", "null"] } } },
      "CatalogAttribute": { "type": "object", "additionalProperties": false, "required": ["id", "code", "name", "value"], "properties": { "id": { "type": "integer" }, "code": { "type": "string" }, "name": { "type": "string" }, "value": { "$ref": "#/components/schemas/CatalogAttributeValue" } } },
      "CatalogProperty": { "type": "object", "additionalProperties": false, "required": ["id", "code", "name", "type", "value", "sort_order"], "properties": { "id": { "type": "integer" }, "code": { "type": "string" }, "name": { "type": "string" }, "type": { "type": "string" }, "value": { "oneOf": [{ "$ref": "#/components/schemas/CatalogAttributeValue" }, { "type": "null" }] }, "sort_order": { "type": "integer" } } },
      "Brand": { "type": "object", "additionalProperties": false, "required": ["id", "name", "slug", "logo_url"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "slug": { "type": "string" }, "logo_url": { "type": ["string", "null"], "format": "uri" } } },
      "Dimensions": { "type": "object", "additionalProperties": false, "required": ["length", "width", "height", "weight"], "properties": { "length": { "type": ["number", "null"] }, "width": { "type": ["number", "null"] }, "height": { "type": ["number", "null"] }, "weight": { "type": ["number", "null"] } } },
      "Variation": { "type": "object", "additionalProperties": false, "required": ["id", "sku", "name", "display_name", "attributes", "images", "price", "old_price", "sale_price", "demping_price", "show_demping", "final_price", "discounts", "currency", "available_quantity", "stock_quantity", "remote_stock_quantity", "fast_remote_stock_quantity", "is_active", "is_available", "is_preorder", "purchase_mode", "can_order", "can_preorder", "dimensions", "updated_at"], "properties": { "id": { "type": "integer" }, "sku": { "type": ["string", "null"] }, "name": { "type": ["string", "null"] }, "display_name": { "type": "string" }, "attributes": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogAttribute" } }, "images": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogImage" } }, "price": { "type": "number" }, "old_price": { "type": ["number", "null"] }, "sale_price": { "type": ["number", "null"] }, "demping_price": { "type": ["number", "null"] }, "show_demping": { "type": "boolean" }, "final_price": { "type": "number" }, "discounts": { "type": "object" }, "currency": { "const": "RUB" }, "available_quantity": { "type": "integer", "minimum": 0, "description": "Reservable local stock for this active variation after active reservations; remote stock is excluded." }, "stock_quantity": { "type": "integer", "minimum": 0, "description": "Raw local stock source." }, "remote_stock_quantity": { "type": ["integer", "string", "null"], "description": "Informational remote stock source. Markers such as >10 are preserved and do not enable Partner checkout." }, "fast_remote_stock_quantity": { "type": ["integer", "string", "null"], "description": "Informational fast remote stock source. Markers such as >10 are preserved and do not enable Partner checkout." }, "is_active": { "type": "boolean" }, "is_available": { "type": "boolean", "description": "True only when ordinary Partner checkout can reserve local stock." }, "is_preorder": { "type": "boolean" }, "purchase_mode": { "type": "string", "enum": ["regular", "preorder", "unavailable"] }, "can_order": { "type": "boolean" }, "can_preorder": { "type": "boolean", "description": "Catalog capability flag; preorder checkout is not part of this contract." }, "dimensions": { "$ref": "#/components/schemas/Dimensions" }, "updated_at": { "type": ["string", "null"], "format": "date-time" } } },
      "Product": { "type": "object", "additionalProperties": false, "required": ["id", "name", "slug", "sku", "short_description", "description", "brand", "categories", "images", "properties", "variations", "price", "old_price", "sale_price", "demping_price", "show_demping", "final_price", "discounts", "currency", "available_quantity", "stock_quantity", "remote_stock_quantity", "fast_remote_stock_quantity", "is_active", "is_available", "is_preorder", "purchase_mode", "can_order", "can_preorder", "dimensions", "updated_at"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "slug": { "type": "string" }, "sku": { "type": ["string", "null"] }, "short_description": { "type": ["string", "null"] }, "description": { "type": ["string", "null"] }, "brand": { "oneOf": [{ "$ref": "#/components/schemas/Brand" }, { "type": "null" }] }, "categories": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }, "images": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogImage" } }, "properties": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogProperty" } }, "variations": { "type": "array", "items": { "$ref": "#/components/schemas/Variation" } }, "price": { "type": "number" }, "old_price": { "type": ["number", "null"] }, "sale_price": { "type": ["number", "null"] }, "demping_price": { "type": ["number", "null"] }, "show_demping": { "type": "boolean" }, "final_price": { "type": "number" }, "discounts": { "type": "object" }, "currency": { "const": "RUB" }, "available_quantity": { "type": "integer", "minimum": 0, "description": "Reservable local stock after active reservations. For products with active variations this is the sum across active variations; otherwise it is the product stock." }, "stock_quantity": { "type": "integer", "minimum": 0, "description": "Raw local stock source on the product record." }, "remote_stock_quantity": { "type": ["integer", "string", "null"], "description": "Informational remote stock source. Markers such as >10 are preserved and do not enable Partner checkout." }, "fast_remote_stock_quantity": { "type": ["integer", "string", "null"], "description": "Informational fast remote stock source. Markers such as >10 are preserved and do not enable Partner checkout." }, "is_active": { "type": "boolean" }, "is_available": { "type": "boolean", "description": "True only when at least one reservable local unit is available for ordinary Partner checkout." }, "is_preorder": { "type": "boolean" }, "purchase_mode": { "type": "string", "enum": ["regular", "preorder", "unavailable"] }, "can_order": { "type": "boolean" }, "can_preorder": { "type": "boolean", "description": "Catalog capability flag distinct from ordinary availability; preorder checkout is not part of this contract." }, "dimensions": { "$ref": "#/components/schemas/Dimensions" }, "updated_at": { "type": ["string", "null"], "format": "date-time" } } },
      "CatalogPageMeta": { "type": "object", "additionalProperties": false, "required": ["next_cursor", "sort", "inactive_in_incremental_feed"], "properties": { "next_cursor": { "type": ["string", "null"] }, "sort": { "type": "array", "items": { "type": "string" } }, "inactive_in_incremental_feed": { "type": "boolean" } } },
      "CategoryPageResponse": { "type": "object", "required": ["success", "data", "meta"], "properties": { "success": { "const": true }, "data": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } }, "meta": { "$ref": "#/components/schemas/CatalogPageMeta" } } },
      "CategoryListResponse": { "type": "object", "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } },
      "ProductPageResponse": { "type": "object", "required": ["success", "data", "meta"], "properties": { "success": { "const": true }, "data": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } } } }, "meta": { "$ref": "#/components/schemas/CatalogPageMeta" } } },
      "QuoteRequest": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/OrderItemInput" } }, "delivery": { "$ref": "#/components/schemas/DeliveryInput" } } },
      "QuoteItem": { "type": "object", "additionalProperties": false, "required": ["good_id", "good_name", "good_sku", "variation_id", "variation_name", "variation_sku", "quantity", "available_quantity", "is_available", "price", "base_price", "sale_price", "final_price", "discounts", "total", "currency"], "properties": { "good_id": { "type": "integer" }, "good_name": { "type": "string" }, "good_sku": { "type": ["string", "null"] }, "variation_id": { "type": ["integer", "null"] }, "variation_name": { "type": ["string", "null"] }, "variation_sku": { "type": ["string", "null"] }, "quantity": { "type": "integer" }, "available_quantity": { "type": "integer" }, "is_available": { "type": "boolean" }, "price": { "type": "number", "multipleOf": 0.01 }, "base_price": { "type": "number", "multipleOf": 0.01 }, "sale_price": { "type": "number", "multipleOf": 0.01 }, "final_price": { "type": "number", "multipleOf": 0.01 }, "discounts": { "type": "object" }, "total": { "type": "number", "multipleOf": 0.01 }, "currency": { "const": "RUB" } } },
      "DeliverySelection": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "type": "string" }, "city_code": { "type": "integer" }, "tariff_code": { "type": "string" }, "tariff_name": { "type": ["string", "null"] }, "period_min": { "type": ["integer", "null"] }, "period_max": { "type": ["integer", "null"] }, "pvz_code": { "type": ["string", "null"] } } },
      "QuoteDelivery": { "type": "object", "additionalProperties": false, "required": ["method_id", "method", "selected", "available_tariffs", "period_min", "period_max"], "properties": { "method_id": { "type": "integer" }, "method": { "type": "string" }, "selected": { "$ref": "#/components/schemas/DeliverySelection" }, "available_tariffs": { "type": "array", "items": { "$ref": "#/components/schemas/DeliveryTariff" } }, "period_min": { "type": ["integer", "null"] }, "period_max": { "type": ["integer", "null"] } } },
      "QuoteTotals": { "type": "object", "additionalProperties": false, "required": ["subtotal", "discount_amount", "delivery_amount", "total", "currency"], "properties": { "subtotal": { "type": "number", "multipleOf": 0.01 }, "discount_amount": { "type": "number", "multipleOf": 0.01 }, "delivery_amount": { "type": "number", "multipleOf": 0.01 }, "total": { "type": "number", "multipleOf": 0.01 }, "currency": { "const": "RUB" } } },
      "QuoteResponse": { "type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "object", "additionalProperties": false, "required": ["id", "items", "subtotal", "discount_amount", "delivery_amount", "total", "currency", "delivery", "expires_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/QuoteItem" } }, "subtotal": { "type": "number", "multipleOf": 0.01 }, "discount_amount": { "type": "number", "multipleOf": 0.01 }, "delivery_amount": { "type": "number", "multipleOf": 0.01 }, "total": { "type": "number", "multipleOf": 0.01 }, "currency": { "const": "RUB" }, "delivery": { "$ref": "#/components/schemas/QuoteDelivery" }, "expires_at": { "type": "string", "format": "date-time" } } } } },
      "DeliveryCity": { "type": "object", "additionalProperties": false, "required": ["code", "name", "region", "country_code"], "properties": { "code": { "type": "integer" }, "name": { "type": "string" }, "region": { "type": ["string", "null"] }, "country_code": { "type": "string", "minLength": 2, "maxLength": 2 } } },
      "DeliveryTariff": { "type": "object", "additionalProperties": false, "required": ["code", "name", "amount", "currency", "period_min", "period_max"], "properties": { "code": { "type": "string" }, "name": { "type": ["string", "null"] }, "amount": { "type": "number", "multipleOf": 0.01 }, "currency": { "const": "RUB" }, "period_min": { "type": ["integer", "null"] }, "period_max": { "type": ["integer", "null"] } } },
      "PickupPoint": { "type": "object", "additionalProperties": false, "required": ["code", "name", "address", "latitude", "longitude", "work_time", "type"], "properties": { "code": { "type": "string" }, "name": { "type": ["string", "null"] }, "address": { "type": ["string", "null"] }, "latitude": { "type": ["number", "null"] }, "longitude": { "type": ["number", "null"] }, "work_time": { "type": ["string", "null"] }, "type": { "type": ["string", "null"] } } },
      "DeliveryCityPage": { "type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/DeliveryCity" } } } },
      "DeliveryTariffPage": { "type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/DeliveryTariff" } } } },
      "PickupPointPage": { "type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/PickupPoint" } } } },
      "PickupPointValidationRequest": { "type": "object", "additionalProperties": false, "required": ["city_code", "pvz_code"], "properties": { "city_code": { "type": "integer" }, "pvz_code": { "type": "string", "maxLength": 100 } } },
      "PickupPointValidation": { "type": "object", "additionalProperties": false, "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "object", "additionalProperties": false, "required": ["is_valid", "pickup_point"], "properties": { "is_valid": { "type": "boolean" }, "pickup_point": { "oneOf": [{ "$ref": "#/components/schemas/PickupPoint" }, { "type": "null" }] } } } } },
      "WebhookPayload": { "type": "object", "additionalProperties": false, "required": ["id", "event", "created_at", "data"], "properties": { "id": { "type": "string", "format": "uuid" }, "event": { "type": "string", "enum": ["test", "order.created", "order.updated", "order.status_changed", "order.cancelled", "payment.status_changed", "payment.succeeded", "payment.failed", "delivery.status_changed", "commission.updated", "commission.approved", "commission.reversed"] }, "created_at": { "type": "string", "format": "date-time" }, "data": { "type": "object" } } },
      "HealthResponse": { "type": "object", "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "object", "required": ["version", "time"], "properties": { "version": { "const": "v1.1" }, "time": { "type": "string", "format": "date-time" } } } } },
      "OrderItemInput": { "type": "object", "required": ["good_id", "quantity"], "properties": { "good_id": { "type": "integer" }, "variation_id": { "type": ["integer", "null"] }, "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 } } },
      "CustomerInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 255 }, "email": { "type": ["string", "null"], "format": "email" }, "phone": { "type": ["string", "null"], "maxLength": 20 } } },
      "DeliveryInput": { "type": ["object", "null"], "properties": { "method_id": { "type": ["integer", "null"] }, "address": { "type": ["string", "null"], "maxLength": 2000 }, "city_code": { "type": ["integer", "null"], "minimum": 1 }, "tariff_code": { "type": ["string", "null"] }, "pvz_code": { "type": ["string", "null"] } }, "description": "Стоимость вычисляется сервером. Для CDEK обязателен city_code." },
      "CreateOrderRequest": {
        "type": "object", "required": ["external_order_id", "items", "customer"],
        "properties": {
          "external_order_id": { "type": "string", "maxLength": 128 }, "quote_id": { "type": ["string", "null"], "format": "uuid", "description": "Рекомендуется для полного v1.1 checkout; legacy v1 запросы без quote сохраняются." }, "items": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/components/schemas/OrderItemInput" } },
          "customer": { "$ref": "#/components/schemas/CustomerInput" }, "delivery": { "$ref": "#/components/schemas/DeliveryInput" }, "payment_method_id": { "type": ["integer", "null"] },
          "comment": { "type": ["string", "null"], "maxLength": 4000 }, "customer_reference": { "type": ["object", "null"], "additionalProperties": true }, "attribution": { "type": ["object", "null"], "additionalProperties": true }, "metadata": { "type": ["object", "null"], "additionalProperties": true }
        }
      },
      "OrderDelivery": { "type": "object", "additionalProperties": false, "required": ["method_id", "method", "address", "details"], "properties": { "method_id": { "type": ["integer", "null"] }, "method": { "type": ["string", "null"] }, "address": { "type": ["string", "null"] }, "details": { "oneOf": [{ "$ref": "#/components/schemas/DeliverySelection" }, { "type": "null" }] } } },
      "OrderPayment": { "type": "object", "additionalProperties": false, "required": ["method_id", "method", "payment_url", "status"], "properties": { "method_id": { "type": ["integer", "null"] }, "method": { "type": ["string", "null"] }, "payment_url": { "type": ["string", "null"], "format": "uri" }, "status": { "type": ["string", "null"] } } },
      "OrderCommission": { "type": "object", "additionalProperties": false, "required": ["rate", "amount", "status"], "properties": { "rate": { "type": "number" }, "amount": { "type": "number", "multipleOf": 0.01 }, "status": { "type": "string" } } },
      "StoreStatus": { "type": "object", "additionalProperties": false, "required": ["order", "payment", "delivery"], "properties": { "order": { "type": ["string", "null"] }, "payment": { "type": ["string", "null"] }, "delivery": { "type": ["string", "null"] } } },
      "Order": {
        "type": "object", "additionalProperties": false, "required": ["id", "external_order_id", "order_number", "status", "currency", "items_amount", "delivery_amount", "total_amount", "delivery", "payment", "store_status", "commission", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "external_order_id": { "type": "string" }, "order_number": { "type": ["string", "null"] }, "status": { "type": "string" }, "currency": { "type": "string", "example": "RUB" },
          "items_amount": { "type": "number" }, "delivery_amount": { "type": "number" }, "total_amount": { "type": "number" },
          "delivery": { "$ref": "#/components/schemas/OrderDelivery" }, "payment": { "$ref": "#/components/schemas/OrderPayment" }, "store_status": { "$ref": "#/components/schemas/StoreStatus" }, "commission": { "$ref": "#/components/schemas/OrderCommission" },
          "created_at": { "type": ["string", "null"], "format": "date-time" }, "updated_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "OrderResponse": { "type": "object", "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "$ref": "#/components/schemas/Order" }, "meta": { "type": "object", "properties": { "idempotent_replay": { "type": "boolean" } } } } },
      "OrderPage": { "type": "object", "additionalProperties": false, "required": ["success", "data", "meta"], "properties": { "success": { "const": true }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } }, "meta": { "$ref": "#/components/schemas/SyncPageMeta" } } },
      "SyncPageMeta": { "type": "object", "additionalProperties": false, "required": ["next_cursor", "per_page", "has_more", "sort"], "properties": { "next_cursor": { "type": ["string", "null"] }, "per_page": { "type": "integer" }, "has_more": { "type": "boolean" }, "sort": { "type": "array", "items": { "type": "string" } } } },
      "CancelOrderRequest": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "maxLength": 1000 } } },
      "Commission": { "type": "object", "additionalProperties": false, "required": ["id", "order_id", "external_order_id", "order_number", "type", "status", "amount", "currency", "reason", "recognized_at", "paid_at", "updated_at"], "properties": { "id": { "type": "integer" }, "order_id": { "type": ["string", "null"], "format": "uuid" }, "external_order_id": { "type": ["string", "null"] }, "order_number": { "type": ["string", "null"] }, "type": { "type": "string" }, "status": { "type": "string" }, "amount": { "type": "number", "multipleOf": 0.01 }, "currency": { "type": "string", "minLength": 3, "maxLength": 3 }, "reason": { "type": ["string", "null"] }, "recognized_at": { "type": ["string", "null"], "format": "date-time" }, "paid_at": { "type": ["string", "null"], "format": "date-time" }, "updated_at": { "type": ["string", "null"], "format": "date-time" } } },
      "CommissionPage": { "type": "object", "additionalProperties": false, "required": ["success", "data", "meta"], "properties": { "success": { "const": true }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Commission" } }, "meta": { "$ref": "#/components/schemas/SyncPageMeta" } } },
      "CheckoutOptionsResponse": { "type": "object", "required": ["success", "data"], "properties": { "success": { "const": true }, "data": { "type": "object", "required": ["delivery_methods", "payment_methods"], "properties": { "delivery_methods": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "payment_methods": { "type": "array", "items": { "type": "object", "additionalProperties": true } } } } } },
      "Payment": { "type": "object", "additionalProperties": false, "required": ["status", "method", "payment_url", "transaction_id", "error"], "properties": { "status": { "type": "string", "enum": ["pending", "failed"] }, "method": { "type": "object", "additionalProperties": false, "required": ["id", "name", "type"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "type": { "type": "string" } } }, "payment_url": { "type": ["string", "null"], "format": "uri" }, "transaction_id": { "type": ["string", "null"] }, "error": { "oneOf": [{ "$ref": "#/components/schemas/ErrorDetail" }, { "type": "null" }] } } },
      "PaymentResponse": { "type": "object", "additionalProperties": false, "required": ["success", "data", "meta"], "properties": { "success": { "const": true }, "data": { "$ref": "#/components/schemas/Payment" }, "meta": { "type": "object", "additionalProperties": false, "required": ["idempotent_replay"], "properties": { "idempotent_replay": { "type": "boolean" } } } } },
      "ErrorDetail": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } },
      "ErrorResponse": { "type": "object", "additionalProperties": false, "required": ["success", "error"], "properties": { "success": { "const": false }, "error": { "$ref": "#/components/schemas/ErrorDetail" } } },
      "Error": { "$ref": "#/components/schemas/ErrorResponse" }
    },
    "responses": {
      "Unauthorized": { "description": "Ошибка HMAC-аутентификации", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Ключ не имеет требуемого scope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Ресурс не найден", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Conflict": { "description": "Конфликт состояния, quote или idempotency key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "ValidationError": { "description": "Ошибка валидации или бизнес-правила", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "RateLimited": { "description": "Превышен rate limit партнёра", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    }
  }
